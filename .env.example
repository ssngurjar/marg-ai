# Marg.ai settings. Copy to .env (never committed). Each build step adds its own block,
# in the same commit as the code that reads it (names: docs/design/contracts.md §7).

# S1
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://marg:marg@localhost:5432/marg
LOG_LEVEL=INFO

# S3 (identity, WhatsApp). Generate the salt with `openssl rand -hex 32` and the key with
# `openssl rand -base64 32`; never change them once users exist.
USER_HASH_SALT=
ADDRESS_ENCRYPTION_KEY=
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com/v26.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WEBHOOK_MAX_BODY_BYTES=5000000
TIMEOUT_WHATSAPP_S=5
