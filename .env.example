# Marg.ai settings. Copy to .env (never committed). Each build step adds its own block,
# in the same commit as the code that reads it (names: docs/design/contracts.md §7).

# S1
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://marg:marg@localhost:5432/marg
LOG_LEVEL=INFO

# S3 (identity, WhatsApp). Generate the salt with `openssl rand -hex 32` and the key with
# `openssl rand -base64 32`; never change them once users exist.
USER_HASH_SALT=
ADDRESS_ENCRYPTION_KEY=
WHATSAPP_GRAPH_BASE_URL=https://graph.facebook.com/v26.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_DISPLAY_NUMBER=
WEBHOOK_MAX_BODY_BYTES=5000000
TIMEOUT_WHATSAPP_S=5

# S4 (turn engine; defaults from contracts §7)
TURN_DEBOUNCE_MS=1000
MAX_MESSAGES_PER_TURN=5
MAX_TURN_ATTEMPTS=3
STALE_MESSAGE_HOURS=23
RECENT_EXCHANGES=6
TURN_BUDGET_S=25
OUTBOX_MAX_ATTEMPTS=5
MAINTENANCE_INTERVAL_S=30
SHUTDOWN_GRACE_S=20
RETENTION_TURN_TEXT_DAYS=90
RETENTION_RAW_PAYLOAD_DAYS=7
PURGE_SWEEP_AFTER_S=600

# E1 upgrade (s04): leases let several workers share the queue. RUN_WORKER_IN_API=false runs
# turns only in `python -m app.worker`. DATABASE_LISTEN_URL: a direct (unpooled) URL for LISTEN
# (Neon's pooled endpoint can't hold one); blank uses DATABASE_URL, polling covers the rest.
LEASE_DURATION_S=60
WORKER_CONCURRENCY=8
OUTBOX_CONCURRENCY=4
OUTBOX_SENDING_STUCK_S=60
POLL_INTERVAL_S=2
RUN_WORKER_IN_API=true
DATABASE_LISTEN_URL=

# S5 (model, prompts, safety core). MODEL_REASONING_EFFORT=minimal per spike E.
MODEL_API_BASE_URL=https://api.meta.ai/v1
MODEL_API_KEY=
MODEL_TEXT=muse-spark-1.3
MODEL_REASONING_EFFORT=minimal
OPEN_MODEL_BASE_URL=https://inference.baseten.co/v1
OPEN_MODEL_API_KEY=
OPEN_MODEL=
TIMEOUT_OPEN_MODEL_S=7
ACTIVITY_REPEAT_DAYS=30
SAFETY_BASE_URL=https://api.deepinfra.com/v1/openai
SAFETY_API_KEY=
SAFETY_MODEL=meta-llama/Llama-Guard-4-12B
SAFETY_POLICY_MODEL_ENABLED=true
USER_SLOT_MAX_CHARS=4000
TIMEOUT_SAFETY_IN_S=5
TIMEOUT_ROUTE_S=4
TIMEOUT_GENERATE_S=12
TIMEOUT_EXPOSURE_S=18
TIMEOUT_MENTOR_S=18
TIMEOUT_GUARD_S=1.5
TIMEOUT_SAFETY_OUT_S=6

# S6 (voice). TTS_ENGINE names the speech model of the ML sidecar (services/ml_sidecar, which
# reads this same file through `make sidecar`): kokoro, Kokoro-82M on the CPU (Apache 2.0).
MODEL_STT=muse-voice-transcribe-1.0
TTS_ENGINE=kokoro
SIDECAR_BASE_URL=http://127.0.0.1:8100
SIDECAR_TOKEN=
TIMEOUT_FETCH_MEDIA_S=5
TIMEOUT_TRANSCRIBE_S=10
TIMEOUT_SYNTHESIZE_S=8
MAX_INBOUND_AUDIO_BYTES=5242880
MIN_VOICE_NOTE_MS=700
MIN_VOICED_MS=300
MAX_VOICE_NOTE_SECONDS=180
TRANSCODE_TIMEOUT_S=5
STT_MAX_KEYWORDS=100
REPLY_AUDIO_FOR_TEXT_INPUT=false

# S10b daily khoj message: off until the templates are approved in WhatsApp Manager
NUDGES_ENABLED=false
NUDGE_TEMPLATE_NAME=marg_daily_khoj
NUDGE_TEMPLATE_NAME_HINGLISH=marg_daily_khoj_hinglish
NUDGE_DAILY_LIMIT=200

# S10b khoj cards (C6): an illustrated card after a good report (Muse Image)
KHOJ_CARD_ENABLED=true
MODEL_IMAGE=muse-image-1.0
IMAGE_REASONING_STRENGTH=low
TIMEOUT_MAKE_CARD_S=30

# S10b activity photos (C7): SAM 3.1 rejects any person, then counts the child's things
PHOTO_INPUT_ENABLED=true
MODEL_SEGMENT=sam-3.1
MAX_INBOUND_IMAGE_BYTES=5242880
TIMEOUT_FETCH_IMAGE_S=5
TIMEOUT_ANALYZE_IMAGE_S=6

# S14 web demo: SESSION_SIGNING_KEY signs the visitor cookie (32+ random bytes, hex)
SESSION_SIGNING_KEY=
SESSION_SIGNING_KEY_PREVIOUS=
DEMO_RATE_LIMIT_PER_HOUR=30
DEMO_IP_RATE_LIMIT_PER_HOUR=90
DEMO_SESSIONS_PER_IP_PER_HOUR=20
DEMO_MAX_AUDIO_BYTES=1000000
DEMO_MAX_IMAGE_BYTES=1000000
DEMO_SSE_MAX_S=600
DEMO_SSE_MAX_CONNECTIONS=200
DAILY_COST_CAP_USD=5

# S13 /status and the admin dashboard (`marg admin-link` prints a 15-minute link)
PUBLIC_BASE_URL=http://127.0.0.1:8000
DASHBOARD_LINK_TTL_S=900
DASHBOARD_COOKIE_TTL_S=7200
K_ANONYMITY_FLOOR=5
K_ANONYMITY_FLOOR_ADMIN=1

# S10b child talk (C13): a child talks to Marg directly, with the parent's consent
CHILD_TALK_ENABLED=true
CHILD_SESSION_MAX_TURNS=6
CHILD_SESSION_MAX_MINUTES=10
CHILD_SESSION_COOLDOWN_MINUTES=30

# S11 retrieval over the official-source corpus (the voice server's /embed)
EMBED_MODEL=intfloat/multilingual-e5-small
TIMEOUT_EMBED_S=5
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SIMILARITY=0.80
QUERY_REWRITE_ENABLED=false

# S15 `marg eval`: the judge model, and the TEST Postgres (docker-compose.test.yml) where each
# run creates and drops its own database. Never the dev or deployed database.
MODEL_JUDGE=muse-spark-1.3
TIMEOUT_JUDGE_S=90
EVAL_DATABASE_ADMIN_URL=postgresql+asyncpg://marg:marg@localhost:55432/marg_test
EVAL_CONCURRENCY=4
