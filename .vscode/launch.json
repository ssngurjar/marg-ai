{
  // Run and debug Marg.ai from VS Code (Run and Debug panel, or F5).
  // Needs the "Python Debugger" extension (it brings debugpy; nothing to install in the venvs).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Marg.ai API + worker",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:create_app",
        "--factory",
        "--host", "127.0.0.1",
        "--port", "8000",
        "--no-access-log"
      ],
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "preLaunchTask": "postgres: up",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "Tests: current file",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["${file}", "-q"],
      "python": "${workspaceFolder}/.venv/bin/python",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
