{
  // Helpers for launch.json. Run any of them from Terminal → Run Task.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "postgres: up",
      "type": "shell",
      "command": "docker compose up -d --wait postgres",
      "options": { "cwd": "${workspaceFolder}" },
      "presentation": { "reveal": "silent", "panel": "shared" },
      "problemMatcher": []
    },
    {
      "label": "migrate (local database)",
      "type": "shell",
      "command": "make migrate",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "tunnel: public URL for WhatsApp and /demo",
      "type": "shell",
      "command": "scripts/dev_tunnel.sh 8000",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "problemMatcher": []
    },
    {
      "label": "check (format, lint, types, unit tests)",
      "type": "shell",
      "command": "make check",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
